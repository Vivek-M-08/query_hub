# Copy to .env and fill in real values. .env is gitignored - never commit real credentials.
#
# analytics_db and the app's own database are configured fully independently -
# they can live on different hosts, ports, and credentials, or the same server.

# --- Analytics database (Postgres) - the MItra data being queried ---
# Local default assumes a Postgres server on this machine with trust auth (no password).
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics_db

# --- App database (Postgres) - sessions/queries/feedback ---
# Can point anywhere; defaults below assume the same local server. Create it
# once with: createdb -h $APP_DB_HOST -p $APP_DB_PORT -U $APP_DB_USER $APP_DB_NAME
APP_DB_USER=postgres
APP_DB_PASSWORD=
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=query_hub

# --- LLM provider (OpenRouter) ---
OPENROUTER_API_KEY=
RETRIEVAL_MODEL=anthropic/claude-sonnet-5
INTERPRETATION_MODEL=anthropic/claude-sonnet-5

# --- LangChain tracing (optional) ---
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
