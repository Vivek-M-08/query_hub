# Copy to .env and fill in real values. .env is gitignored - never commit real credentials.
#
# Each dataset option below is fully independent: DB_HOST/DB_PORT/etc. are looked up
# per-option, so MENTORING/SCP/PROJECTS/KATHA/MITRA can each live on a different server
# without any code change. DB_ENGINE is optional - it defaults to "mysql" for KATHA and
# "postgresql" for everything else (the app's original assumption); set it explicitly for
# any option that doesn't match that default, e.g. if MITRA turns out to be mysql.

# --- MENTORING ---
MENTORING_DB_USER=
MENTORING_DB_PASSWORD=
MENTORING_DB_HOST=
MENTORING_DB_PORT=
MENTORING_DB_NAME=
# MENTORING_DB_ENGINE=postgresql

# --- SCP ---
SCP_DB_USER=
SCP_DB_PASSWORD=
SCP_DB_HOST=
SCP_DB_PORT=
SCP_DB_NAME=
# SCP_DB_ENGINE=postgresql

# --- PROJECTS ---
PROJECTS_DB_USER=
PROJECTS_DB_PASSWORD=
PROJECTS_DB_HOST=
PROJECTS_DB_PORT=
PROJECTS_DB_NAME=
# PROJECTS_DB_ENGINE=postgresql

# --- KATHA ---
KATHA_DB_USER=
KATHA_DB_PASSWORD=
KATHA_DB_HOST=
KATHA_DB_PORT=
KATHA_DB_NAME=
# KATHA_DB_ENGINE=mysql

# --- MITRA (pending connection details, see docs/planning/v2-makeover) ---
MITRA_DB_USER=
MITRA_DB_PASSWORD=
MITRA_DB_HOST=
MITRA_DB_PORT=
MITRA_DB_NAME=
MITRA_DB_ENGINE=

# --- LLM provider ---
OPENAI_API_KEY=
# OPENROUTER_API_KEY=       # required once the v2-makeover OpenRouter switch lands

# --- LangChain tracing (optional) ---
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
